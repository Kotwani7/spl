# Local development only. Generate a private key before deployment.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Optional alternate SQLite file for rehearsals; defaults to ./db.sqlite3.
# SQLITE_PATH=/absolute/path/to/rehearsal.sqlite3

ADMIN_EMAIL=admin@example.com
GOOGLE_FORM_URL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=admin@example.com

# Secure cookies and HTTPS redirects default to True when DEBUG=False.
# Set TRUST_PROXY_HEADERS=True only behind a proxy that strips spoofed headers.
TRUST_PROXY_HEADERS=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
